# Секреты — только здесь (файл .env не коммитится).
BOT_TOKEN=123456:ABC...
# Telegram user_id через запятую — только они управляют ботом
ALLOWED_USER_IDS=111111111
# Супергруппа с темами (бот — админ с правом «Управление темами»). Пусто — алерты в личку.
ALERT_CHAT_ID=-1001234567890

POSTGRES_PASSWORD=change-me

# Источники данных
PUMPPORTAL_WS=wss://pumpportal.fun/api/data
# ОБЯЗАТЕЛЬНО для сделок: ключ PumpPortal, на кошельке которого ≥0.02 SOL (pumpportal.fun).
# Без ключа PumpPortal отдаёт только создания монет. Приватный ключ кошелька боту не нужен.
PUMPPORTAL_API_KEY=
# RPC Helius (бесплатный тариф подходит). Из него же берётся websocket logsSubscribe —
# основной поток всех созданий и сделок Pump.fun.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_RPS=5
HELIUS_API_KEY=
# Поток Helius transactionSubscribe (тариф Developer, трафик 20 кредитов/МБ):
#   backup — только при обрыве PumpPortal (по умолчанию), primary — постоянно (~$260/мес), off — никогда
HELIUS_STREAM=backup
# Постоянный logsSubscribe (дорого: ~1,7 млн кредитов в сутки) — по умолчанию выключен
LOGS_STREAM=off
# История за 30 дней через Dune (необязательно): python -m scanner history --days 30
DUNE_API_KEY=

# HTTPS-домен страницы перехода в приложение Pump.fun
REDIRECT_BASE=https://scanner.example.com

LOG_LEVEL=INFO

# --- Внешние источники (необязательно; без ключа источник выключен, бот работает дальше) ---
# GMGN OpenAPI: метки smart_degen/KOL, безопасность токена, PnL кошелька. Ключ: https://gmgn.ai/ai
GMGN_API_KEY=
# Jupiter Price API: без ключа 0.5 запроса/с, с бесплатным ключом 1. Ключ: https://portal.jup.ag
JUPITER_API_KEY=
# Birdeye: бесплатный Standard — 1 запрос/с; PnL кошельков с тарифа Starter. Ключ: https://bds.birdeye.so
BIRDEYE_API_KEY=
# Solscan Pro: метки бирж — тариф Level 2. Ключ: https://pro-api.solscan.io
SOLSCAN_API_KEY=
