# Секреты — только здесь (файл .env не коммитится).
BOT_TOKEN=123456:ABC...
# Telegram user_id через запятую — только они управляют ботом
ALLOWED_USER_IDS=111111111
# Супергруппа с темами (бот — админ с правом «Управление темами»). Пусто — алерты в личку.
ALERT_CHAT_ID=-1001234567890

POSTGRES_PASSWORD=change-me

# Источники данных
PUMPPORTAL_WS=wss://pumpportal.fun/api/data
PUMPPORTAL_API_KEY=
# RPC Helius (бесплатный тариф подходит). Из него же берётся websocket logsSubscribe —
# основной поток всех созданий и сделок Pump.fun.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_RPS=5
# PumpPortal отдаёт сделки только с ключом, на балансе которого ≥0.02 SOL. Без ключа — только создания.
# Необязательно: сделки и так приходят через logsSubscribe.
# Платный Helius Enhanced WebSockets (необязательно): HELIUS_WS=wss://atlas-mainnet.helius-rpc.com/?api-key=...
HELIUS_API_KEY=

# HTTPS-домен страницы перехода в приложение Pump.fun
REDIRECT_BASE=https://scanner.example.com

LOG_LEVEL=INFO
